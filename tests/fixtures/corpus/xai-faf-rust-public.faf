faf_version: 2.5.0
project_name: xai-faf-rust
mission: |
  High-performance Rust CLI for xAI/Grok FAF context generation.
  220x faster than Node.js. Zero-copy parsing. Sub-millisecond response.
  For Grok. For the rockets. For Mars.
tech_stack:
  - Rust 2021 Edition
  - faf-rust-sdk
  - clap (CLI)
  - serde + serde_yaml
  - crc32fast
  - byteorder
key_files:
  - src/main.rs
  - src/lib.rs
  - src/binary/mod.rs
  - src/binary/header.rs
  - src/binary/section.rs
  - src/scoring/score.rs
  - src/commands/compile.rs
  - BINARY-FORMAT.md
architecture: |
  Three-layer architecture:
  1. Commands Layer (src/commands/) - CLI entry points
  2. Core Layer (src/lib.rs) - FAF parsing and scoring
  3. Binary Layer (src/binary/) - FAFB compilation
commands:
  build: cargo build --release
  test: cargo test
  lint: cargo clippy
  run: cargo run -- <command>
author: wolfejam
license: Private
repository: https://github.com/Wolfe-Jam/xai-faf-rust
project:
  name: faf-cli
  goal: The Persistent AI Context Standard • Foundation Layer for AI • IANA-Registered • Anthropic-Approved • project.faf = AI's foundation
