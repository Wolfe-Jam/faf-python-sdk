# bun-sticky - Fastest bun under the sum
# Zero dependencies. Pure Zig. Wolfejam slots.
# The poster child FAF CLI for Bun/Anthropic.

faf_version: 2.5.0

project:
  name: bun-sticky-zig
  goal: Zig-native FAF CLI with Wolfejam slot-based scoring
  main_language: Zig
  type: cli
  version: 1.0.0
  author: wolfejam
  license: MIT

stack:
  frontend: none
  css_framework: none
  ui_library: none
  state_management: none
  backend: none
  api_type: none
  runtime: Zig
  database: none
  connection: none
  hosting: GitHub
  build: zig build
  cicd: GitHub Actions

human_context:
  who: Developers who want ultra-fast FAF scoring
  what: CLI that scores project.faf files using Wolfejam slots
  why: Zig is what Bun is built on - speaks Bun's native language
  where: Terminal, CI/CD pipelines
  when: When milliseconds matter
  how: zig build -Doptimize=ReleaseFast && ./zig-out/bin/faf score

testing:
  framework: Zig builtin test
  health_score: Championship

architecture:
  pattern: command-dispatch
  commands:
    - score: Show FAF score + tier
    - init: Create project.faf template
    - sync: Sync to CLAUDE.md
    - help: Show commands

scoring:
  system: Wolfejam slot-based
  total_slots: 21 base + 12 enterprise (33 Mk4 canonical)
  categories:
    - project: 3 slots
    - frontend: 4 slots
    - backend: 5 slots
    - universal: 3 slots
    - human: 6 slots
    - enterprise: 12 slots (only when a monorepo signal is present)
  formula: (Filled / Applicable) x 100
  note: Zig-native approximation of faf-cli's live scorer, not authoritative

dedication: For Bun. For Claude. For speed.
